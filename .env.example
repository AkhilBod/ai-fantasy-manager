# --- LLM ---
# "anthropic" (ANTHROPIC_API_KEY) for local dev, "bedrock" (AWS creds + AWS_REGION) in Lambda
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
LLM_MODEL=claude-opus-5

# --- ESPN --- (copy from browser cookies on fantasy.espn.com)
ESPN_S2=
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}

# --- Safety ---
# 1 = log every write (ESPN transactions, iMessages) instead of executing. Default ON.
DRY_RUN=1

# --- Storage ---
# "local" writes JSON files under ./data ; "dynamo" uses the CDK tables
STORE=local
TABLE_PREFIX=ffm
OUTBOUND_QUEUE_URL=
PROFILE_BUCKET=

# --- Mac agent ---
INBOUND_API_URL=
INBOUND_API_SECRET=
MY_PHONE=+15555550100
